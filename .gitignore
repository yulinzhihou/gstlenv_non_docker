# ============================================================
# TLBB 万能环境安装器 - Git 忽略规则
# 离线安装包(大体积二进制)不进版本管理, 通过 scripts/pack_offline.sh 重新生成
# ============================================================

# 离线组件 (按发行版版本存放, 见 offline-packs/)
/offline/

# 版本化离线压缩包
/offline-packs/
*.tar.gz
*.tgz

# 二进制包 (rpm/deb/so 等)
*.rpm
*.deb
*.so

# 系统/编辑器
.DS_Store
Thumbs.db
*.swp
*~
