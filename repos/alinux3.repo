# 阿里云 Alinux 3 (RHEL8 兼容) - 官方镜像源
[alinux3-os]
name=Alinux-3 - OS
baseurl=https://mirrors.aliyun.com/alinux/3/os/$basearch/
gpgcheck=0
enabled=1

[alinux3-updates]
name=Alinux-3 - Updates
baseurl=https://mirrors.aliyun.com/alinux/3/updates/$basearch/
gpgcheck=0
enabled=1

[alinux3-plus]
name=Alinux-3 - Plus
baseurl=https://mirrors.aliyun.com/alinux/3/plus/$basearch/
gpgcheck=0
enabled=1

[alinux3-powertools]
name=Alinux-3 - PowerTools
baseurl=https://mirrors.aliyun.com/alinux/3/powertools/$basearch/
gpgcheck=0
enabled=1