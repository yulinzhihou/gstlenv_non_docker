# CentOS 6.x (EOL) - 阿里云 vault 归档源
[base]
name=CentOS-6 - Base - aliyun-vault
baseurl=https://mirrors.aliyun.com/centos-vault/6.10/os/$basearch/
        http://mirrors.163.com/centos-vault/6.10/os/$basearch/
gpgcheck=0
enabled=1

