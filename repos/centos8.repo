# CentOS 8.x (EOL) - 国内 vault 多镜像源 (dnf, 阿里云/腾讯云/华为云/中科大/清华/163 依次兜底)
[baseos]
name=CentOS-8 - BaseOS - vault
baseurl=https://mirrors.aliyun.com/centos-vault/8.5.2111/BaseOS/$basearch/os/
        https://mirrors.cloud.tencent.com/centos-vault/8.5.2111/BaseOS/$basearch/os/
        https://mirrors.huaweicloud.com/centos-vault/8.5.2111/BaseOS/$basearch/os/
        https://mirrors.ustc.edu.cn/centos-vault/8.5.2111/BaseOS/$basearch/os/
        https://mirrors.tuna.tsinghua.edu.cn/centos-vault/8.5.2111/BaseOS/$basearch/os/
        http://mirrors.163.com/centos-vault/8.5.2111/BaseOS/$basearch/os/
gpgcheck=0
enabled=1

