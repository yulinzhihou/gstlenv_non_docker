        https://mirrors.aliyun.com/centos-stream/9-stream/BaseOS/$basearch/os/
        https://mirrors.cloud.tencent.com/centos-stream/9-stream/BaseOS/$basearch/os/
        https://mirrors.ustc.edu.cn/centos-stream/9-stream/BaseOS/$basearch/os/
        https://mirrors.tuna.tsinghua.edu.cn/centos-stream/9-stream/BaseOS/$basearch/os/
gpgcheck=0
enabled=1

