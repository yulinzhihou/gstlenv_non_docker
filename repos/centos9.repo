# CentOS Stream 9 - 阿里云源 (dnf)
[baseos]
name=CentOS-Stream-9 - BaseOS - aliyun
baseurl=https://mirrors.aliyun.com/centos-stream/9-stream/BaseOS/$basearch/os/
        https://mirrors.cloud.tencent.com/centos-stream/9-stream/BaseOS/$basearch/os/
        https://mirrors.huaweicloud.com/centos-stream/9-stream/BaseOS/$basearch/os/
gpgcheck=0
enabled=1

[appstream]
name=CentOS-Stream-9 - AppStream - aliyun
baseurl=https://mirrors.aliyun.com/centos-stream/9-stream/AppStream/$basearch/os/
        https://mirrors.cloud.tencent.com/centos-stream/9-stream/AppStream/$basearch/os/
gpgcheck=0
enabled=1

[extras]
name=CentOS-Stream-9 - Extras - aliyun
baseurl=https://mirrors.aliyun.com/centos-stream/9-stream/extras/$basearch/os/
gpgcheck=0
enabled=1

[crb]
name=CentOS-Stream-9 - CRB - aliyun
baseurl=https://mirrors.aliyun.com/centos-stream/9-stream/CRB/$basearch/os/
gpgcheck=0
enabled=1