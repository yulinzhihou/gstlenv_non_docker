# 华为 openEuler 24.03 LTS (RHEL9 风格)
[openeuler-os]
name=openEuler-24.03 - OS
baseurl=https://mirrors.huaweicloud.com/openeuler/openEuler-24.03-LTS/OS/$basearch/
gpgcheck=0
enabled=1

[openeuler-update]
name=openEuler-24.03 - Update
baseurl=https://mirrors.huaweicloud.com/openeuler/openEuler-24.03-LTS/update/$basearch/
gpgcheck=0
enabled=1

[openeuler-epol]
name=openEuler-24.03 - EPOL
baseurl=https://mirrors.huaweicloud.com/openeuler/openEuler-24.03-LTS/EPOL/main/$basearch/
gpgcheck=0
enabled=1